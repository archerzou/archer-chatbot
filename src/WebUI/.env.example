# Copy to `.env` and adjust if your Backend / IdentityServer run on different ports.
# These are the fixed dev ports used when the services run standalone
# (`dotnet run --project src/Backend` / `src/IdentityServer`). When running via .NET Aspire the
# ports are dynamic - read them from the Aspire dashboard and set them here.

# Backend (proxied by Vite under /api, /tickets, /customer, /manual).
VITE_API_TARGET=http://localhost:5165

# IdentityServer authority (OIDC). The SPA/oidc-client-ts talks to this directly (needs the dev
# HTTPS cert trusted and http://localhost:5173 in the client's AllowedCorsOrigins).
VITE_OIDC_AUTHORITY=https://localhost:7275
